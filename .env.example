# FaceTwin Environment Variables Template
# Copy this file to .env and configure your local dataset paths

# YFP (YouTube Facial Palsy) Archive Locations
YFP_ARCHIVE_1="${HOME}/Downloads/Image.zip"
YFP_ARCHIVE_2="${HOME}/Downloads/Image2.zip"
YFP_ARCHIVE_3="${HOME}/Downloads/Image3.zip"
YFP_EXTRACTED_DIR="${HOME}/Downloads/YFP_Extracted_2026"

# Clinical Data Paths (PPMI)
PPMI_DIR="data/raw/ppmi"

# Device Configuration
FACETWIN_DEVICE="cpu"
